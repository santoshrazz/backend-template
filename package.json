	"main": "dist/app.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/bin/www.js",
		"start:dev": "nodemon",
		"test": "node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "husky install || true",
		"migrate": "ts-node src/scripts/migrate.ts",
		"migrate:up": "ts-node src/scripts/run-migration.ts up",
		"migrate:down": "ts-node src/scripts/run-migration.ts down",
		"migrate:status": "ts-node src/scripts/run-migration.ts status",
		"migrate:reset": "ts-node src/scripts/run-migration.ts reset",
		"migrate:create": "ts-node src/scripts/new-migration.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
